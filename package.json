{
    "name":  "super-high",
    "version":  "0.1.13",
    "type":  "module",
    "description":  "Super High desktop workspace built with Vue 3 + Vite + Tauri 2.x",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vue-tsc --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "cli":  "cargo run --manifest-path src-tauri/Cargo.toml --bin superhigh-cli --",
                    "mobile:dev":  "vite --config vite.mobile.config.ts --host 0.0.0.0",
                    "mobile:build":  "vue-tsc --noEmit \u0026\u0026 vite build --config vite.mobile.config.ts \u0026\u0026 node scripts/prepare-mobile-dist.mjs",
                    "mobile:sync":  "npm run mobile:build \u0026\u0026 cap sync android",
                    "mobile:android":  "npm run mobile:sync \u0026\u0026 cap open android",
                    "mobile:apk":  "node scripts/build-mobile-apk.mjs",
                    "tauri":  "tauri",
                    "tauri:dev":  "tauri dev",
                    "tauri:build":  "tauri build",
                    "dragon:icon":  "node scripts/create-dragon-icon-template.mjs",
                    "dragon:icon:32":  "node scripts/create-dragon-icon-template.mjs 32",
                    "dragon:icon:64":  "node scripts/create-dragon-icon-template.mjs 64",
                    "dragon:export":  "node scripts/export-dragon-image.mjs",
                    "dragon:export:all":  "node scripts/export-dragon-image.mjs --all"
                },
    "dependencies":  {
                         "@capacitor/android":  "^8.4.2",
                         "@capacitor/cli":  "^8.4.2",
                         "@capacitor/core":  "^8.4.2",
                         "@deepseek-ai/dsh":  "0.1.2-rc.1",
                         "@tauri-apps/api":  "^2.0.0",
                         "@xterm/addon-fit":  "^0.10.0",
                         "@xterm/addon-webgl":  "^0.18.0",
                         "@xterm/xterm":  "^5.5.0",
                         "cytoscape":  "^3.33.4",
                         "docx-preview":  "0.3.7",
                         "lucide-vue-next":  "^1.0.0",
                         "marked":  "^15.0.12",
                         "monaco-editor":  "^0.52.2",
                         "pdfjs-dist":  "6.3.289",
                         "pinia":  "^2.3.1",
                         "vue":  "^3.5.33",
                         "xlsx":  "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
                         "yaml":  "^2.9.0"
                     },
    "devDependencies":  {
                            "@tauri-apps/cli":  "^2.0.0",
                            "@types/cytoscape":  "^3.21.9",
                            "@types/node":  "^22.10.1",
                            "@vitejs/plugin-vue":  "^5.2.4",
                            "@vue/tsconfig":  "^0.7.0",
                            "jsdom":  "^25.0.1",
                            "typescript":  "^5.7.2",
                            "vite":  "^5.4.11",
                            "vitest":  "^2.1.8",
                            "vue-tsc":  "^2.2.12"
                        }
}
