{
  "name": "super-high",
  "version": "0.1.32",
  "private": true,
  "type": "module",
  "description": "Super High desktop workspace replicated with Vue 3 + Vite + Tauri 2.x",
  "scripts": {
    "dev": "vite",
    "superhigh-html": "node scripts/superhigh-html.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin superhigh-cli --",
    "mobile:dev": "vite --config vite.mobile.config.ts --host 0.0.0.0",
    "mobile:build": "vue-tsc --noEmit && vite build --config vite.mobile.config.ts && node scripts/prepare-mobile-dist.mjs",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:apk": "node scripts/build-mobile-apk.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "cytoscape": "^3.33.4",
    "docx-preview": "0.3.7",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^15.0.12",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "6.3.289",
    "pinia": "^2.3.1",
    "vue": "^3.5.33",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.12"
  }
}
