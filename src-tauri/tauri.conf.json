{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super High",
  "version": "0.1.0",
  "identifier": "com.superhigh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; frame-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "Super High",
        "width": 1500,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
