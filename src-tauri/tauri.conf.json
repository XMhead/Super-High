{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super High",
  "version": "0.1.17",
  "identifier": "com.superhigh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run mobile:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; font-src 'self' data: blob:; frame-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' data: blob: http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "create": false,
        "title": "Super High",
        "width": 1500,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4M0NCM0M4NjgwMjE4QzQKUldURUdBSm95TE04dU5ZUFV4cENTd1ppYXVxOTRveGtvckI3bnJVb2ZiMS9ScllrV1Q2N3lxK3IK",
      "endpoints": [
        "https://github.com/XMhead/Super-High/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "windows/image-viewer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist-mobile/": "dist-mobile/"
    },
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "doc",
          "docx"
        ],
        "name": "SuperHigh.Word",
        "description": "Super High Word document viewer",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "SuperHigh.Pdf",
        "description": "Super High PDF viewer",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "mp4",
          "webm",
          "ogg",
          "ogv",
          "mov"
        ],
        "name": "SuperHigh.Video",
        "description": "Super High video viewer",
        "role": "Viewer",
        "mimeType": "video/*"
      }
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
